# 服务器配置
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
SERVER_MODE=debug

# 数据库配置
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=cjadmin
DB_SSLMODE=disable

# JWT配置
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRE_HOURS=24

# 上传配置
UPLOAD_MAX_SIZE=10485760
UPLOAD_PATH=./uploads

# 安全配置
BCRYPT_COST=10
PASSWORD_MIN_LENGTH=6
SESSION_TIMEOUT=3600

# 日志配置
LOG_LEVEL=info
LOG_FILE=./logs/app.log
